# ==============================================================================
#  SOVEREIGN OS DIM - .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
dist/
build/
*.egg

# Virtual Environments
.venv/
venv/
ENV/

# PyInstaller
*.manifest

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini

# Design System (generated)
design-system/

# Output
PILOT_OUTPUT/

# Exclusions pour la distribution pre-compilee (accessible sans Python)
!docs/*.pdf

# Caches outils
.pytest_cache/
.ruff_cache/

# Node - outillage de test uniquement (Playwright pour le smoke test de
# rendu), jamais embarque dans l'app ni sur poste hopital (cf package.json)
node_modules/

# Entrainement LoRA CimSuggester - logs et checkpoints intermediaires locaux,
# seul l'adaptateur final (backend/ml/models/cim_lora_adapter/) est commite
backend/ml/models/_cim_lora_checkpoints/
backend/ml/models/cim_lora_*.log

# Jamais versionnes : hooks locaux, echantillons internes etablissement, scripts .bat (regle EDR)
hooks/
sample/
*.bat
scripts/analyze_real_data.py
