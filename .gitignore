# ==============================================================================
#  SOVEREIGN OS DIM - .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environments
.venv/
venv/
ENV/

# PyInstaller
*.spec
*.manifest

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
Thumbs.db
.DS_Store
desktop.ini

# Design System (generated)
design-system/

# Output
PILOT_OUTPUT/

# Manuel PDF généré par tools/generate_manual.py (non commité)
docs/Sovereign_OS_DIM_Manuel.pdf

# Réglages d'agent IDE locaux (allowlist de commandes par utilisateur)
.claude/
.cursor/
.vscode/

# Moulinette FICHCOMP - défense en profondeur contre données et binaires
# Aucune donnée réelle (exports transports nominatifs) ni binaire ne doit être commité.
*.xlsx
*.xlsm
*.exe
tools/moulinette_fichcomp/build/
tools/moulinette_fichcomp/dist/
tools/moulinette_fichcomp/Utilisateur/
tools/moulinette_fichcomp/Fichier/

# Caches outils
.pytest_cache/
.ruff_cache/

# Node - outillage de test uniquement (Playwright pour le smoke test de
# rendu), jamais embarque dans l'app ni sur poste hopital (cf package.json)
node_modules/

# Entrainement LoRA CimSuggester - logs et checkpoints intermediaires locaux,
# seul l'adaptateur final (backend/ml/models/cim_lora_adapter/) est commite
backend/ml/models/_cim_lora_checkpoints/
backend/ml/models/cim_lora_*.log

# Jamais versionnes : hooks locaux, echantillons internes etablissement, scripts .bat (regle EDR)
hooks/
sample/
*.bat
scripts/analyze_real_data.py
